# Server-side environment variables (Vercel Serverless Functions / /api)
ORP_USERNAME=
ORP_CREDENTIAL=

# Optional comma-separated extra origins allowed to call /api/turn-credentials
# Example: https://your-domain.vercel.app
ALLOWED_ORIGINS=

# Client-side Firebase Configuration (Create React App)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DB_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
